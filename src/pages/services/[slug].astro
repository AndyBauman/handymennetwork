---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MenuCard from "@/components/MenuCard.astro";
import GeoAnswerBlock from "@/components/GeoAnswerBlock.astro";
import { menuCategories, getCategory } from "@/data/menu";
import { SITE_NAME, SITE_ORIGIN } from "@/data/constants";
import { getCategoryOffersJsonLd } from "@/lib/pricing-stats";
import { serviceAreas } from "@/data/areas";

export function getStaticPaths() {
  return menuCategories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const cat = getCategory(slug!);

if (!cat) {
  return Astro.redirect("/services");
}

const prices = cat.items.map((i) => i.price);
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);
const title = `${cat.title} — fixed prices — ${SITE_NAME}`;
const description = `Menu-priced ${cat.title.toLowerCase()} for your home. Typical range $${minPrice}–$${maxPrice}. Clear scope, no guessing.`;

const pageUrl = `${SITE_ORIGIN}/services/${slug}`;
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "All repairs",
      item: `${SITE_ORIGIN}/services`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: cat.title,
      item: pageUrl,
    },
  ],
};
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#collection`,
  url: pageUrl,
  name: title,
  description,
  isPartOf: { "@id": `${SITE_ORIGIN}/#website` },
};
const offersJsonLd = getCategoryOffersJsonLd(slug!, pageUrl);
const relatedCities = [
  "houston-tx",
  "los-angeles-ca",
  "chicago-il",
  "atlanta-ga",
  "phoenix-az",
  "philadelphia-pa",
]
  .map((s) => serviceAreas.find((a) => a.slug === s))
  .filter(Boolean);

const otherCategories = menuCategories.filter((c) => c.slug !== slug).slice(0, 5);
---

<BaseLayout
  title={title}
  description={description}
  extraJsonLd={[breadcrumbJsonLd, collectionJsonLd, ...(offersJsonLd ? [offersJsonLd] : [])]}
>
  <nav class="text-lg mb-6" aria-label="Breadcrumb">
    <a href="/services" class="text-brand-green font-semibold underline">All repairs</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <span>{cat.title}</span>
  </nav>
  <h1 class="font-display text-4xl font-bold text-brand-green">
    <span aria-hidden="true">{cat.emoji}</span> {cat.title}
  </h1>

  <div class="mt-8">
    <GeoAnswerBlock
      id={`about-${slug}`}
      heading={`How much does ${cat.title.toLowerCase()} cost?`}
      answer={`On Handymen Network, ${cat.title.toLowerCase()} is sold as fixed menu line items. As published on this page, prices for ${cat.title.toLowerCase()} currently range from $${minPrice} to $${maxPrice}. Each card lists time estimate, what’s included, and whether basic materials are included or you supply them.`}
      facts={[
        `${cat.items.length} fixed-price options in this category.`,
        "You see the total for the described scope before you book.",
        "A vetted local pro is matched by skill and availability—you don’t browse profiles.",
      ]}
    />
  </div>

  <p class="mt-8 text-xl max-w-3xl">
    Prices below are for the work described. Materials note is on each card. Related categories live
    on the <a href="/services" class="text-brand-green font-semibold underline">main menu</a> for easy
    bundling. For typical handyman costs across all categories, see our
    <a href="/pricing" class="text-brand-green font-semibold underline">pricing guide</a>.
  </p>
  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    {cat.items.map((item) => <MenuCard item={item} />)}
  </div>

  <section class="mt-16" aria-labelledby="related-cats">
    <h2 id="related-cats" class="font-display text-2xl font-bold text-brand-green">
      Related repair categories
    </h2>
    <ul class="mt-4 flex flex-wrap gap-3">
      {
        otherCategories.map((c) => (
          <li>
            <a
              href={`/services/${c.slug}`}
              class="inline-flex min-h-tap items-center px-4 py-2 rounded-xl bg-white border-2 border-brand-green/20 font-semibold hover:border-brand-green"
            >
              {c.emoji} {c.title}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/services"
          class="inline-flex min-h-tap items-center px-4 py-2 rounded-xl bg-brand-green text-brand-cream font-semibold"
        >
          Full menu →
        </a>
      </li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="book-in-city">
    <h2 id="book-in-city" class="font-display text-2xl font-bold text-brand-green">
      Book {cat.title.toLowerCase()} in major metros
    </h2>
    <p class="mt-3 text-lg max-w-3xl">
      Same menu pricing model nationwide. City pages explain coverage, FAQs, and how matching works
      locally.
    </p>
    <ul class="mt-4 flex flex-wrap gap-3">
      {
        relatedCities.map(
          (a) =>
            a && (
              <li>
                <a
                  href={`/areas/${a.slug}`}
                  class="inline-flex min-h-tap items-center px-4 py-2 rounded-xl bg-white border-2 border-brand-green/20 font-semibold hover:border-brand-green"
                >
                  {a.name}, {a.state}
                </a>
              </li>
            ),
        )
      }
      <li>
        <a href="/areas" class="inline-flex min-h-tap items-center px-4 py-2 rounded-xl border-2 border-brand-amber font-semibold">
          All cities →
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
