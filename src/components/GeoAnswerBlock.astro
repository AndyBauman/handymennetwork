---
/**
 * Answer-first block for GEO citability (AI Overviews / ChatGPT / Perplexity).
 * Keep facts specific and quotable — not marketing fluff.
 */
interface Props {
  heading: string;
  answer: string;
  facts?: string[];
  headingLevel?: "h2" | "h3";
  /** Required: the section's aria-labelledby points at this heading id. */
  id: string;
}

const { heading, answer, facts = [], headingLevel = "h2", id } = Astro.props;
const Tag = headingLevel;
---

<section
  class="rounded-2xl border-2 border-brand-green/20 bg-white p-6 sm:p-8 shadow-sm"
  aria-labelledby={id}
>
  <Tag id={id} class="font-display text-2xl sm:text-3xl font-bold text-brand-green">
    {heading}
  </Tag>
  <p class="mt-4 text-xl text-brand-charcoal leading-relaxed">{answer}</p>
  {
    facts.length > 0 && (
      <ul class="mt-5 space-y-2 text-lg">
        {facts.map((fact) => (
          <li class="flex gap-3">
            <span class="text-brand-amber font-bold shrink-0" aria-hidden="true">
              •
            </span>
            <span>{fact}</span>
          </li>
        ))}
      </ul>
    )
  }
</section>
